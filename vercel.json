{
    "version": 2,
    "builds": [
      {
        "src": "/*",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/public/(.*)",
        "dest": "/public/$1",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/public/(.*).(jpg|jpeg|png|gif|webp|svg|ico)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/$2"
          }
        ]
      },
      {
        "source": "/public/(.*).(mp4|webm|ogg)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "video/$2"
          }
        ]
      },
      {
        "source": "/public/(.*).(woff|woff2|eot|ttf|otf)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "font/$2"
          }
        ]
      }
    ]
  }